<hc:Window x:Class="FingerprintBrowser.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:vm="clr-namespace:FingerprintBrowser.ViewModels"
        mc:Ignorable="d"
        Title="设置"
        Height="550" Width="600"
        MinHeight="500" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}">

    <Window.DataContext>
        <vm:SettingsViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 外观设置 -->
                <TextBlock Text="外观" Style="{StaticResource GroupHeaderStyle}"/>
                <Border Style="{StaticResource InfoCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="主题" Style="{StaticResource InfoLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      Width="150" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="语言" Style="{StaticResource InfoLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      Width="150" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 常规设置 -->
                <TextBlock Text="常规" Style="{StaticResource GroupHeaderStyle}"/>
                <Border Style="{StaticResource InfoCardStyle}">
                    <StackPanel>
                        <CheckBox Content="开机自动启动" IsChecked="{Binding AutoStartWithSystem}" Margin="0,0,0,12"/>
                        <CheckBox Content="最小化到系统托盘" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,12"/>
                        <CheckBox Content="显示通知" IsChecked="{Binding ShowNotifications}"/>
                    </StackPanel>
                </Border>

                <!-- 浏览器设置 -->
                <TextBlock Text="浏览器" Style="{StaticResource GroupHeaderStyle}"/>
                <Border Style="{StaticResource InfoCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="最大并发浏览器数" Style="{StaticResource InfoLabelStyle}"/>
                            <hc:NumericUpDown Value="{Binding MaxConcurrentBrowsers}" 
                                              Minimum="1" Maximum="50"
                                              Width="120" HorizontalAlignment="Right"/>
                        </Grid>
                        <CheckBox Content="关闭时清除缓存" IsChecked="{Binding ClearCacheOnClose}" Margin="0,0,0,12"/>
                        <CheckBox Content="关闭时清除Cookie" IsChecked="{Binding ClearCookiesOnClose}"/>
                    </StackPanel>
                </Border>

                <!-- 日志设置 -->
                <TextBlock Text="日志" Style="{StaticResource GroupHeaderStyle}"/>
                <Border Style="{StaticResource InfoCardStyle}">
                    <StackPanel>
                        <CheckBox Content="启用日志记录" IsChecked="{Binding EnableLogging}" Margin="0,0,0,12"/>
                        <Button Content="打开日志文件夹" Style="{StaticResource FunctionButtonStyle}"
                                Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="恢复默认" Style="{StaticResource FunctionButtonStyle}" 
                    Command="{Binding ResetToDefaultsCommand}" Margin="0,0,8,0"/>
            <Button Content="保存" Style="{StaticResource PrimaryActionButton}" 
                    Command="{Binding SaveSettingsCommand}"/>
        </StackPanel>
    </Grid>
</hc:Window>
