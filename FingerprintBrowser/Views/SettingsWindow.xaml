<hc:Window x:Class="FingerprintBrowser.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="设置" Height="450" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="常规设置" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="主题"/>
            <hc:ComboBox x:Name="ThemeComboBox" Margin="0,0,0,15" SelectionChanged="ThemeComboBox_SelectionChanged">
                <ComboBoxItem Content="深色" Tag="Dark"/>
                <ComboBoxItem Content="浅色" Tag="Light"/>
                <ComboBoxItem Content="深蓝" Tag="DarkBlue"/>
            </hc:ComboBox>

            <TextBlock Text="启动延迟 (毫秒)"/>
            <hc:NumericUpDown Value="{Binding StartupDelay}" Minimum="0" Maximum="10000" Margin="0,0,0,15"/>

            <TextBlock Text="最大并发数"/>
            <hc:NumericUpDown Value="{Binding MaxConcurrency}" Minimum="1" Maximum="20" Margin="0,0,0,15"/>

            <TextBlock Text="浏览器路径"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <System.Windows.Controls.TextBox Text="{Binding BrowserPath}"/>
                <Button Grid.Column="1" Content="浏览" Margin="10,0,0,0" Click="BrowseBrowser_Click"/>
            </Grid>

            <CheckBox Content="启动时检查更新" IsChecked="{Binding CheckUpdateOnStartup}" Margin="0,0,0,10"/>
            <CheckBox Content="关闭时最小化到托盘" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="100" Click="Cancel_Click" Margin="0,0,10,0"/>
            <Button Content="保存" Width="100" Style="{StaticResource ButtonPrimary}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</hc:Window>
