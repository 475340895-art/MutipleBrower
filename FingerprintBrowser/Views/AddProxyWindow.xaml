<Window x:Class="FingerprintBrowser.Views.AddProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="添加代理" Width="460" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f5f6fa"
        ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="代理类型" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
            <ComboBox x:Name="ProxyTypeBox" SelectedIndex="0" Margin="0,0,0,16">
                <ComboBoxItem Content="HTTP"/>
                <ComboBoxItem Content="HTTPS"/>
                <ComboBoxItem Content="SOCKS5"/>
                <ComboBoxItem Content="SS"/>
            </ComboBox>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="代理服务器" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                    <TextBox x:Name="HostBox" hc:InfoElement.PlaceholderText="IP 地址"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="端口" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                    <TextBox x:Name="PortBox" hc:InfoElement.PlaceholderText="端口"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="用户名" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                    <TextBox x:Name="UserBox" hc:InfoElement.PlaceholderText="可选"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="密码" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PassBox" hc:InfoElement.PlaceholderText="可选"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="TestResult" Text="" FontSize="12" Foreground="#52c41a" Margin="0,0,0,8" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="100" Height="36" Margin="0,0,12,0"
                    Background="White" Foreground="#1677ff" BorderBrush="#1677ff"
                    Click="Test_Click" Cursor="Hand">测试连接</Button>
            <Button Width="80" Height="36" Margin="0,0,12,0"
                    Background="White" Foreground="#666" BorderBrush="#d9d9d9"
                    Click="Cancel_Click" Cursor="Hand">取消</Button>
            <Button Width="80" Height="36"
                    Background="#1677ff" Foreground="White" BorderBrush="{x:Null}"
                    Click="Save_Click" Cursor="Hand">保存</Button>
        </StackPanel>
    </Grid>
</Window>
