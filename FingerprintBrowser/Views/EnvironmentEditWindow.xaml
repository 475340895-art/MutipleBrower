<Window x:Class="FingerprintBrowser.Views.EnvironmentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="新建环境" Width="520" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f5f6fa"
        ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="基本设置" FontSize="15" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,16"/>

                <TextBlock Text="环境名称" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" hc:InfoElement.PlaceholderText="请输入环境名称" Margin="0,0,0,16"/>

                <TextBlock Text="所属分组" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                <ComboBox x:Name="GroupBox" hc:InfoElement.PlaceholderText="选择分组" Margin="0,0,0,16"/>

                <TextBlock Text="备注" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                <TextBox x:Name="RemarksBox" hc:InfoElement.PlaceholderText="可选备注" 
                         AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <Separator Margin="0,0,0,16"/>

                <TextBlock Text="代理设置" FontSize="15" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,16"/>

                <TextBlock Text="代理类型" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                <ComboBox x:Name="ProxyTypeBox" SelectedIndex="0" Margin="0,0,0,16">
                    <ComboBoxItem Content="不使用代理"/>
                    <ComboBoxItem Content="HTTP"/>
                    <ComboBoxItem Content="HTTPS"/>
                    <ComboBoxItem Content="SOCKS5"/>
                    <ComboBoxItem Content="SS"/>
                </ComboBox>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="代理服务器" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                        <TextBox x:Name="ProxyHostBox" hc:InfoElement.PlaceholderText="IP 地址"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="端口" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                        <TextBox x:Name="ProxyPortBox" hc:InfoElement.PlaceholderText="端口"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="用户名" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                        <TextBox x:Name="ProxyUserBox" hc:InfoElement.PlaceholderText="可选"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="密码" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ProxyPassBox" hc:InfoElement.PlaceholderText="可选"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,16"/>

                <TextBlock Text="指纹设置" FontSize="15" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,16"/>

                <TextBlock Text="UserAgent" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                <ComboBox x:Name="UABox" SelectedIndex="0" Margin="0,0,0,16">
                    <ComboBoxItem Content="Chrome 120 / Win10"/>
                    <ComboBoxItem Content="Chrome 119 / Win11"/>
                    <ComboBoxItem Content="Chrome 120 / macOS"/>
                    <ComboBoxItem Content="Firefox 121 / Win10"/>
                </ComboBox>

                <TextBlock Text="屏幕分辨率" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                <ComboBox x:Name="ResolutionBox" SelectedIndex="0" Margin="0,0,0,16">
                    <ComboBoxItem Content="1920x1080"/>
                    <ComboBoxItem Content="1366x768"/>
                    <ComboBoxItem Content="1536x864"/>
                    <ComboBoxItem Content="2560x1440"/>
                </ComboBox>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox Content="启用 WebRTC" x:Name="WebRTCCheck" IsChecked="True" Margin="0,0,24,0"/>
                    <CheckBox Content="启用 JavaScript" x:Name="JSCheck" IsChecked="True" Margin="0,0,24,0"/>
                    <CheckBox Content="启用 Cookies" x:Name="CookieCheck" IsChecked="True"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="80" Height="36" Margin="0,0,12,0"
                    Background="White" Foreground="#666" BorderBrush="#d9d9d9"
                    Click="Cancel_Click" Cursor="Hand">
                取消
            </Button>
            <Button Width="80" Height="36"
                    Background="#1677ff" Foreground="White" BorderBrush="{x:Null}"
                    Click="Save_Click" Cursor="Hand">
                保存
            </Button>
        </StackPanel>
    </Grid>
</Window>
