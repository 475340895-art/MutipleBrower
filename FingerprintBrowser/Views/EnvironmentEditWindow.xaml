<hc:Window x:Class="FingerprintBrowser.Views.EnvironmentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="编辑环境"
        Height="650" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource RegionBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Basic Info -->
        <GroupBox Grid.Row="0" Header="基本信息" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="名称：" VerticalAlignment="Center"/>
                <hc:TextBox x:Name="NameBox" Grid.Column="1" Height="32" VerticalAlignment="Center"/>
                
                <TextBlock Grid.Row="1" Text="分组：" VerticalAlignment="Center"/>
                <ComboBox x:Name="GroupCombo" Grid.Row="1" Grid.Column="1" Height="32" VerticalAlignment="Center"/>
                
                <TextBlock Grid.Row="2" Text="启动网址：" VerticalAlignment="Center"/>
                <hc:TextBox x:Name="UrlBox" Grid.Row="2" Grid.Column="1" Height="32" VerticalAlignment="Center"/>
                
                <TextBlock Grid.Row="3" Text="备注：" VerticalAlignment="Center"/>
                <hc:TextBox x:Name="RemarkBox" Grid.Row="3" Grid.Column="1" Height="32" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>
        
        <!-- Browser Settings -->
        <GroupBox Grid.Row="1" Header="浏览器设置" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="分辨率：" VerticalAlignment="Center"/>
                <ComboBox x:Name="ResolutionCombo" Grid.Column="1" Height="32" VerticalAlignment="Center"/>
                
                <TextBlock Grid.Row="1" Text="时区：" VerticalAlignment="Center"/>
                <ComboBox x:Name="TimezoneCombo" Grid.Row="1" Grid.Column="1" Height="32" VerticalAlignment="Center"/>
                
                <TextBlock Grid.Row="2" Text="语言：" VerticalAlignment="Center"/>
                <ComboBox x:Name="LanguageCombo" Grid.Row="2" Grid.Column="1" Height="32" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>
        
        <!-- Proxy Settings -->
        <GroupBox Grid.Row="2" Header="代理设置">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="代理类型：" VerticalAlignment="Center"/>
                <ComboBox x:Name="ProxyTypeCombo" Grid.Column="1" Height="32" VerticalAlignment="Center"
                          SelectionChanged="ProxyTypeCombo_SelectionChanged">
                    <ComboBoxItem Content="无代理" IsSelected="True"/>
                    <ComboBoxItem Content="HTTP"/>
                    <ComboBoxItem Content="HTTPS"/>
                    <ComboBoxItem Content="SOCKS5"/>
                </ComboBox>
                
                <TextBlock Grid.Row="1" Text="主机：" VerticalAlignment="Center"/>
                <hc:TextBox x:Name="ProxyHostBox" Grid.Row="1" Grid.Column="1" Height="32" VerticalAlignment="Center"/>
                
                <TextBlock Grid.Row="2" Text="端口：" VerticalAlignment="Center"/>
                <hc:TextBox x:Name="ProxyPortBox" Grid.Row="2" Grid.Column="1" Height="32" VerticalAlignment="Center"/>
                
                <TextBlock Grid.Row="3" Text="用户名：" VerticalAlignment="Center"/>
                <hc:TextBox x:Name="ProxyUserBox" Grid.Row="3" Grid.Column="1" Height="32" VerticalAlignment="Center"/>
                
                <TextBlock Grid.Row="4" Text="密码：" VerticalAlignment="Center"/>
                <hc:PasswordBox x:Name="ProxyPassBox" Grid.Row="4" Grid.Column="1" Height="32" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnSave" Content="保存" Width="100" Height="36" 
                    Style="{StaticResource ButtonPrimary}" Click="BtnSave_Click"/>
            <Button Content="取消" Width="100" Height="36" Margin="10,0,0,0" 
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</hc:Window>
