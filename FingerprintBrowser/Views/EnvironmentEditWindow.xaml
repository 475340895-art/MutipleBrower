<hc:Window x:Class="FingerprintBrowser.Views.EnvironmentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="环境编辑" Height="650" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Basic Info -->
                <TextBlock Text="基本信息" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <TextBlock Text="名称"/>
                <System.Windows.Controls.TextBox x:Name="NameTextBox" Text="{Binding Name}" Margin="0,0,0,10"/>

                <TextBlock Text="分组"/>
                <hc:ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" 
                            DisplayMemberPath="Name" Margin="0,0,0,10"/>

                <TextBlock Text="备注"/>
                <System.Windows.Controls.TextBox Text="{Binding Remark}" Height="60" TextWrapping="Wrap" 
                                                AcceptsReturn="True" Margin="0,0,0,15"/>

                <!-- Browser Settings -->
                <TextBlock Text="浏览器设置" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="分辨率"/>
                <hc:ComboBox SelectedItem="{Binding Resolution}" Margin="0,0,0,10">
                    <ComboBoxItem Content="1920x1080"/>
                    <ComboBoxItem Content="1366x768"/>
                    <ComboBoxItem Content="1536x864"/>
                    <ComboBoxItem Content="1440x900"/>
                    <ComboBoxItem Content="2560x1440"/>
                </hc:ComboBox>

                <TextBlock Text="时区"/>
                <System.Windows.Controls.TextBox Text="{Binding Timezone}" Margin="0,0,0,10"/>

                <TextBlock Text="语言"/>
                <System.Windows.Controls.TextBox Text="{Binding Languages}" Margin="0,0,0,10"/>

                <TextBlock Text="UserAgent"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <System.Windows.Controls.TextBox Text="{Binding UserAgent}"/>
                    <Button Grid.Column="1" Content="生成" Click="GenerateUserAgent_Click" Margin="10,0,0,0"/>
                </Grid>

                <CheckBox Content="WebGL 指纹随机" IsChecked="{Binding RandomizeWebGL}" Margin="0,0,0,10"/>

                <!-- Proxy Settings -->
                <TextBlock Text="代理设置" FontSize="14" FontWeight="Bold" Margin="0,10,0,10"/>

                <TextBlock Text="代理类型"/>
                <hc:ComboBox SelectedItem="{Binding ProxyType}" Margin="0,0,0,10">
                    <ComboBoxItem Content="不使用代理"/>
                    <ComboBoxItem Content="HTTP"/>
                    <ComboBoxItem Content="HTTPS"/>
                    <ComboBoxItem Content="SOCKS5"/>
                </hc:ComboBox>

                <TextBlock Text="代理地址"/>
                <System.Windows.Controls.TextBox Text="{Binding ProxyHost}" Margin="0,0,0,10"/>

                <TextBlock Text="端口"/>
                <System.Windows.Controls.TextBox Text="{Binding ProxyPort}" Margin="0,0,0,10"/>

                <TextBlock Text="用户名"/>
                <System.Windows.Controls.TextBox Text="{Binding ProxyUsername}" Margin="0,0,0,10"/>

                <TextBlock Text="密码"/>
                <System.Windows.Controls.PasswordBox Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="取消" Width="100" Click="Cancel_Click" Margin="0,0,10,0"/>
            <Button Content="保存" Width="100" Style="{StaticResource ButtonPrimary}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</hc:Window>
