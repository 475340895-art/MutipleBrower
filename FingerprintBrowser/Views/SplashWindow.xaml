<hc:Window x:Class="FingerprintBrowser.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Fingerprint Browser"
        Height="350" Width="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Border CornerRadius="10" BorderBrush="#667EEA" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1E1E2E" Offset="0"/>
                <GradientStop Color="#2D2D44" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Logo 区域 -->
                <Border Width="80" Height="80" CornerRadius="20" Margin="0,0,0,30">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#667EEA" Offset="0"/>
                            <GradientStop Color="#764BA2" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="FB" FontSize="32" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <!-- 应用名称 -->
                <TextBlock Text="Fingerprint Browser" FontSize="24" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="专业级指纹浏览器" FontSize="14"
                           Foreground="#9999AA" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                
                <!-- 加载动画 - 使用标准 ProgressBar -->
                <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Width="200" Height="4"
                             Foreground="#667EEA" Background="#333355"/>
                
                <!-- 状态文本 -->
                <TextBlock x:Name="StatusText" Text="正在启动..." FontSize="12"
                           Foreground="#666688" HorizontalAlignment="Center" Margin="0,15,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</hc:Window>
