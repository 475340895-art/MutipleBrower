<hc:Window x:Class="FingerprintBrowser.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="加载中..." Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#1a1a2e" CornerRadius="10" Padding="30">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="48" 
                       Foreground="#667eea" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <TextBlock Text="指纹浏览器" FontSize="24" FontWeight="Bold" 
                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>
            
            <hc:LoadingCircle/>
            
            <TextBlock x:Name="StatusText" Text="正在加载..." FontSize="12" 
                       Foreground="#a0a0a0" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
    </Border>
</hc:Window>
