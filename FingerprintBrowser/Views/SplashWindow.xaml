<hc:Window x:Class="FingerprintBrowser.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="正在启动..."
        Width="400" Height="250"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Background="{DynamicResource RegionBrush}"
            CornerRadius="12"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="20" ShadowDepth="5"/>
        </Border.Effect>

        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Logo/Icon -->
                <Ellipse Width="80" Height="80" Margin="0,0,0,20">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#1D4ED8" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- App Name -->
                <TextBlock Text="指纹浏览器"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"/>

                <!-- Loading Text -->
                <TextBlock x:Name="LoadingText"
                           Text="正在初始化..."
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                <!-- Progress Bar -->
                <hc:LoadingCircle Width="30" Height="30"
                                  HorizontalAlignment="Center"
                                  Margin="0,16,0,0"/>
            </StackPanel>

            <!-- Version -->
            <TextBlock Text="v1.0.0"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Right"
                       Margin="0,0,16,10"
                       FontSize="10"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </Grid>
    </Border>
</hc:Window>
