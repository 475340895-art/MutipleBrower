<hc:Window x:Class="FingerprintBrowser.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="指纹浏览器"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Height="400" Width="600">

    <Window.Resources>
        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1a1a2e" Offset="0"/>
            <GradientStop Color="#0f0f1a" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00d4ff" Offset="0"/>
            <GradientStop Color="#7c3aed" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border Background="{StaticResource BgGradient}" CornerRadius="16">
        <Grid>
            <!-- 装饰圆 -->
            <Ellipse Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-100,50,0" Opacity="0.1">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#667eea" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="200" Height="200" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-50,0,0,-50" Opacity="0.1">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#00d4ff" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 内容 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Logo -->
                <Border Width="80" Height="80" CornerRadius="20" Background="{StaticResource AccentGradient}" 
                        Margin="0,0,0,30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#667eea" Opacity="0.5"/>
                    </Border.Effect>
                    <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z"
                          Fill="White" Width="40" Height="40" Stretch="Uniform"/>
                </Border>

                <!-- 标题 -->
                <TextBlock Text="指纹浏览器" FontSize="32" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#667eea" Opacity="0.3"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Fingerprint Browser" FontSize="14" Foreground="#666688" 
                           HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <!-- 加载动画 -->
                <hc:LoadingCircle Width="40" Height="40" Foreground="{StaticResource AccentGradient}" 
                                  HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- 状态文字 -->
                <TextBlock x:Name="LoadingText" Text="正在初始化..." FontSize="13" 
                           Foreground="#8888aa" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <!-- 进度条 -->
                <Border Width="300" Height="4" Background="#2d2d44" CornerRadius="2" HorizontalAlignment="Center">
                    <Border x:Name="ProgressBar" Width="0" Height="4" Background="{StaticResource AccentGradient}" 
                            CornerRadius="2" HorizontalAlignment="Left">
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                         From="0" To="300" Duration="0:0:2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </Border>
            </StackPanel>

            <!-- 版本信息 -->
            <TextBlock Text="v1.0.0" FontSize="11" Foreground="#444466" 
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,20,15"/>
        </Grid>
    </Border>
</hc:Window>
