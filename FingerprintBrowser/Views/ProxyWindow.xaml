<hc:Window x:Class="FingerprintBrowser.Views.ProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="代理管理"
        Height="550" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#f5f6fa">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="添加代理" Width="90" Height="32" Background="#1677ff" Foreground="White" 
                    BorderBrush="{x:Null}" Click="BtnAdd_Click" Cursor="Hand"/>
            <Button Content="测试选中" Width="90" Height="32" Margin="8,0,0,0" 
                    Background="White" Foreground="#1677ff" BorderBrush="#1677ff" Click="BtnTest_Click" Cursor="Hand"/>
            <Button Content="删除选中" Width="90" Height="32" Margin="8,0,0,0"
                    Background="White" Foreground="#ff4d4f" BorderBrush="#ff4d4f" Click="BtnDelete_Click" Cursor="Hand"/>
            <Button Content="批量导入" Width="90" Height="32" Margin="8,0,0,0"
                    Background="White" Foreground="#666" BorderBrush="#d9d9d9" Click="BtnImport_Click" Cursor="Hand"/>
        </StackPanel>
        
        <!-- Proxy List -->
        <DataGrid x:Name="ProxyGrid" Grid.Row="1" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#e8e8e8" Background="White"
                  AlternatingRowBackground="#fafafa">
            <DataGrid.Columns>
                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80"/>
                <DataGridTextColumn Header="服务器" Binding="{Binding Host}" Width="*"/>
                <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="80"/>
                <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="100"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</hc:Window>
