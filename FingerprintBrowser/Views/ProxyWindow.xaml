<hc:Window x:Class="FingerprintBrowser.Views.ProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="代理管理"
        Height="550" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="BtnAdd" Content="添加" Width="80" Height="32" Style="{StaticResource ButtonPrimary}" Click="BtnAdd_Click"/>
            <Button x:Name="BtnDelete" Content="删除" Width="80" Height="32" Margin="10,0,0,0" Click="BtnDelete_Click"/>
            <Button x:Name="BtnTest" Content="测试" Width="80" Height="32" Margin="10,0,0,0" Click="BtnTest_Click"/>
            <Button x:Name="BtnImport" Content="批量导入" Width="90" Height="32" Margin="10,0,0,0" Click="BtnImport_Click"/>
            <Button x:Name="BtnExport" Content="导出" Width="80" Height="32" Margin="10,0,0,0" Click="BtnExport_Click"/>
            <Button x:Name="BtnClose" Content="关闭" Width="80" Height="32" Margin="10,0,0,0" Click="BtnClose_Click"/>
        </StackPanel>
        
        <!-- Proxy List -->
        <DataGrid x:Name="ProxyGrid" Grid.Row="1" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80"/>
                <DataGridTextColumn Header="主机" Binding="{Binding Host}" Width="150"/>
                <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="80"/>
                <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="100"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
                <DataGridTextColumn Header="延迟" Binding="{Binding Latency}" Width="80"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SecondaryRegionBrush}" 
                CornerRadius="4" Padding="10,5" Margin="0,15,0,0">
            <TextBlock x:Name="StatusText" Text="就绪" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </Border>
    </Grid>
</hc:Window>
