<hc:Window x:Class="FingerprintBrowser.Views.ProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:vm="clr-namespace:FingerprintBrowser.ViewModels"
        xmlns:converters="clr-namespace:FingerprintBrowser.Converters"
        mc:Ignorable="d"
        Title="代理管理"
        Height="600" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}">

    <Window.DataContext>
        <vm:ProxyViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:ProxyStatusToTextConverter x:Key="ProxyStatusTextConverter"/>
        <converters:ProxyStatusToColorConverter x:Key="ProxyStatusColorConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource InfoCardStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource FunctionButtonStyle}" Command="{Binding AddProxyCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="{DynamicResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform"/>
                        <TextBlock Text="添加代理" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource VerticalSeparatorStyle}" Margin="8,0"/>

                <Button Style="{StaticResource FunctionButtonStyle}" Command="{Binding TestProxyCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z" Fill="{DynamicResource SuccessBrush}" Width="14" Height="14" Stretch="Uniform"/>
                        <TextBlock Text="测试选中" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource FunctionButtonStyle}" Command="{Binding TestAllProxiesCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z" Fill="{DynamicResource WarningBrush}" Width="14" Height="14" Stretch="Uniform"/>
                        <TextBlock Text="测试全部" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource VerticalSeparatorStyle}" Margin="8,0"/>

                <Button Style="{StaticResource FunctionButtonStyle}" Command="{Binding ImportProxiesCommand}">
                    <TextBlock Text="导入"/>
                </Button>

                <Button Style="{StaticResource FunctionButtonStyle}" Command="{Binding ExportProxiesCommand}">
                    <TextBlock Text="导出"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- 代理列表 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Proxies}"
                  SelectedItem="{Binding SelectedProxy}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="None"
                  Margin="0,12,0,0">
            <DataGrid.Columns>
                <!-- 状态 -->
                <DataGridTemplateColumn Header="状态" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                         Fill="{Binding Status, Converter={StaticResource ProxyStatusColorConverter}}"/>
                                <TextBlock Text="{Binding Status, Converter={StaticResource ProxyStatusTextConverter}}"
                                           Foreground="{Binding Status, Converter={StaticResource ProxyStatusColorConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 名称 -->
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 类型 -->
                <DataGridTextColumn Header="类型" Binding="{Binding ProxyType}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 地址 -->
                <DataGridTextColumn Header="地址" Width="200">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Host" StringFormat="{}{0}:{Port}"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 响应时间 -->
                <DataGridTextColumn Header="响应时间" Binding="{Binding ResponseTime, StringFormat={}{0}ms}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 上次测试 -->
                <DataGridTextColumn Header="上次测试" Binding="{Binding LastTestTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 操作 -->
                <DataGridTemplateColumn Header="操作" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource IconButtonStyle}" ToolTip="编辑"
                                        Command="{Binding DataContext.EditProxyCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" Fill="{DynamicResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" ToolTip="删除"
                                        Command="{Binding DataContext.DeleteProxyCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Fill="{DynamicResource DangerBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource SecondRegionBrush}" Padding="12,6" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                <TextBlock Grid.Column="1" VerticalAlignment="Center" 
                           Foreground="{DynamicResource SecondaryTextBrush}">
                    <Run Text="总计:"/>
                    <Run Text="{Binding Proxies.Count, Mode=OneWay}"/>
                    <Run Text="个代理"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 加载遮罩 -->
        <Border Grid.RowSpan="3" Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <hc:LoadingCircle/>
        </Border>
    </Grid>
</hc:Window>
