<hc:Window x:Class="FingerprintBrowser.Views.ProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="代理管理" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="添加代理" Style="{StaticResource ButtonSuccess}" Click="AddProxy_Click" Margin="0,0,10,0"/>
            <Button Content="批量测试" Click="BatchTest_Click" Margin="0,0,10,0"/>
            <Button Content="批量导入" Click="BatchImport_Click" Margin="0,0,10,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  ItemsSource="{Binding Proxies}" SelectedItem="{Binding SelectedProxy}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="状态" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="10" Height="10" HorizontalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding StatusColor}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80"/>
                <DataGridTextColumn Header="地址" Binding="{Binding Host}" Width="*"/>
                <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="80"/>
                <DataGridTextColumn Header="延迟" Binding="{Binding Latency}" Width="80"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="150"/>
                <DataGridTemplateColumn Header="操作" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="测试" Click="TestProxy_Click" Margin="2"/>
                                <Button Content="删除" Click="DeleteProxy_Click" Margin="2"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</hc:Window>
