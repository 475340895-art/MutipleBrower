<hc:Window x:Class="FingerprintBrowser.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:vm="clr-namespace:FingerprintBrowser.ViewModels"
        xmlns:converters="clr-namespace:FingerprintBrowser.Converters"
        mc:Ignorable="d"
        Title="指纹浏览器 - Fingerprint Browser"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RegionBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:BrowserStatusToTextConverter x:Key="StatusTextConverter"/>
        <converters:BrowserStatusToColorConverter x:Key="StatusColorConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
        <converters:DateTimeFormatConverter x:Key="DateTimeConverter"/>
    </Window.Resources>

    <hc:Window.NonClientAreaContent>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,140,0">
            <!-- 最小化 -->
            <Button Style="{StaticResource ButtonIcon}" Click="MinimizeButton_Click" Padding="10" ToolTip="最小化">
                <Path Data="M4,13H20" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.5"/>
            </Button>
            <!-- 最大化/还原 -->
            <Button Style="{StaticResource ButtonIcon}" Click="MaximizeButton_Click" Padding="10" ToolTip="最大化">
                <Path x:Name="MaximizeIcon" Data="M4,4H20V20H4V4Z" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.5"/>
            </Button>
            <!-- 关闭 -->
            <Button Style="{StaticResource ButtonIcon}" Click="CloseButton_Click" Padding="10" ToolTip="关闭">
                <Path Data="M6,6L18,18M6,18L18,6" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.5"/>
            </Button>
        </StackPanel>
    </hc:Window.NonClientAreaContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="{DynamicResource SecondRegionBrush}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧功能按钮 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource FunctionButtonStyle}" Command="{Binding CreateEnvironmentCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Fill="{DynamicResource ForegroundBrush}" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="新建环境" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource VerticalSeparatorStyle}" Margin="8,0"/>

                    <Button Style="{StaticResource FunctionButtonStyle}" Command="{Binding BatchStartCommand}" 
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="{DynamicResource SuccessBrush}" Width="14" Height="14" Stretch="Uniform"/>
                            <TextBlock Text="批量启动" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource FunctionButtonStyle}" Command="{Binding BatchStopCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M18,18H6V6H18V18Z" Fill="{DynamicResource DangerBrush}" Width="14" Height="14" Stretch="Uniform"/>
                            <TextBlock Text="批量停止" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource VerticalSeparatorStyle}" Margin="8,0"/>

                    <Button Style="{StaticResource FunctionButtonStyle}" Command="{Binding CreateGroupCommand}">
                        <TextBlock Text="新建分组"/>
                    </Button>
                </StackPanel>

                <!-- 搜索框 -->
                <hc:SearchBar Grid.Column="1" 
                              Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                              hc:InfoElement.Placeholder="搜索环境..."
                              Style="{StaticResource SearchBarExtend}"
                              Width="300"
                              Margin="20,0"/>

                <!-- 右侧导入导出 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource FunctionButtonStyle}" Command="{Binding ImportEnvironmentCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" Fill="{DynamicResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="导入" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FunctionButtonStyle}" Command="{Binding ExportEnvironmentCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M12,19L8,15H10.5V10H13.5V15H16L12,19Z" Fill="{DynamicResource SuccessBrush}" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="导出" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧分组列表 -->
            <Border Grid.Column="0" Background="{DynamicResource SecondRegionBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="分组列表" Style="{StaticResource GroupHeaderStyle}" Margin="12,12,12,8"/>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Groups}"
                             SelectedItem="{Binding SelectedGroup}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding Color}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" 
                                               Foreground="{DynamicResource SecondaryTextBrush}">
                                        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                                        <Run Text="/"/>
                                        <Run Text="{Binding RunningCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"/>

            <!-- 中间环境列表 -->
            <Border Grid.Column="2" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="环境列表" Style="{StaticResource GroupHeaderStyle}" Margin="12,12,12,8"/>

                    <!-- 环境列表 -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SelectedGroup.Environments}"
                              SelectedItem="{Binding SelectedEnvironment}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderThickness="0"
                              Margin="8">
                        <DataGrid.Columns>
                            <!-- 状态 -->
                            <DataGridTemplateColumn Header="状态" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Center"
                                                 Fill="{Binding Status, Converter={StaticResource StatusColorConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 名称 -->
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 代理 -->
                            <DataGridTextColumn Header="代理" Binding="{Binding Proxy.Name}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 启动URL -->
                            <DataGridTextColumn Header="启动URL" Binding="{Binding StartupUrl}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 上次运行 -->
                            <DataGridTextColumn Header="上次运行" Width="140">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="LastRunTime" Converter="{StaticResource DateTimeConverter}" ConverterParameter="yyyy-MM-dd HH:mm"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 操作 -->
                            <DataGridTemplateColumn Header="操作" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="启动"
                                                    Command="{Binding DataContext.StartEnvironmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Visibility="{Binding Status, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}">
                                                <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="{DynamicResource SuccessBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="停止"
                                                    Command="{Binding DataContext.StopEnvironmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Visibility="{Binding Status, Converter={StaticResource BoolToVisConverter}}">
                                                <Path Data="M18,18H6V6H18V18Z" Fill="{DynamicResource DangerBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" Visibility="Collapsed"/>

            <!-- 右侧详情面板 -->
            <Border Grid.Column="3" Background="{DynamicResource SecondRegionBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- 基本信息 -->
                        <TextBlock Text="基本信息" Style="{StaticResource GroupHeaderStyle}"/>
                        <Border Style="{StaticResource InfoCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="名称" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Text="{Binding SelectedEnvironment.Name}" Style="{StaticResource InfoValueStyle}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="分组" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Text="{Binding SelectedGroup.Name}" Style="{StaticResource InfoValueStyle}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="状态" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Text="{Binding SelectedEnvironment.Status, Converter={StaticResource StatusTextConverter}}" 
                                               Style="{StaticResource InfoValueStyle}" HorizontalAlignment="Right"
                                               Foreground="{Binding SelectedEnvironment.Status, Converter={StaticResource StatusColorConverter}}"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="创建时间" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Text="{Binding SelectedEnvironment.CreatedAt, Converter={StaticResource DateTimeConverter}}" 
                                               Style="{StaticResource InfoValueStyle}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 浏览器指纹 -->
                        <TextBlock Text="浏览器指纹" Style="{StaticResource GroupHeaderStyle}"/>
                        <Border Style="{StaticResource InfoCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="分辨率" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Style="{StaticResource InfoValueStyle}" HorizontalAlignment="Right">
                                        <Run Text="{Binding SelectedEnvironment.ScreenWidth}"/>
                                        <Run Text="x"/>
                                        <Run Text="{Binding SelectedEnvironment.ScreenHeight}"/>
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="时区" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Text="{Binding SelectedEnvironment.TimeZone, StringFormat='UTC{}{0}'}" Style="{StaticResource InfoValueStyle}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="语言" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Text="{Binding SelectedEnvironment.Language}" Style="{StaticResource InfoValueStyle}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="User Agent" Style="{StaticResource InfoLabelStyle}"/>
                                </Grid>
                                <TextBlock Text="{Binding SelectedEnvironment.UserAgent}" 
                                           Style="{StaticResource InfoValueStyle}" 
                                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- 代理配置 -->
                        <TextBlock Text="代理配置" Style="{StaticResource GroupHeaderStyle}"/>
                        <Border Style="{StaticResource InfoCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="启用代理" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Text="{Binding SelectedEnvironment.UseProxy, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Text}" 
                                               Style="{StaticResource InfoValueStyle}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="代理信息" Style="{StaticResource InfoLabelStyle}"/>
                                    <TextBlock Text="{Binding SelectedEnvironment.Proxy.Host}" Style="{StaticResource InfoValueStyle}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 操作按钮 -->
                        <StackPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryActionButton}" 
                                    Content="编辑环境"
                                    Command="{Binding StartEnvironmentCommand}"
                                    Margin="0,0,0,8"/>
                            <Button Style="{StaticResource FunctionButtonStyle}" 
                                    Content="复制环境"
                                    Command="{Binding DuplicateEnvironmentCommand}"/>
                            <Button Style="{StaticResource FunctionButtonStyle}" 
                                    Content="删除环境"
                                    Foreground="{DynamicResource DangerBrush}"
                                    Command="{Binding DeleteEnvironmentCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource SecondRegionBrush}" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="运行中:"/>
                        <Run Text="{Binding RunningCount}" Foreground="{DynamicResource SuccessBrush}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding TotalCount}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 加载遮罩 -->
        <Border Grid.RowSpan="3" Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <hc:LoadingCircle/>
        </Border>
    </Grid>
</hc:Window>
