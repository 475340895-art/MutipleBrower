<Window x:Class="FingerprintBrowser.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:FingerprintBrowser.Converters"
        xmlns:models="clr-namespace:FingerprintBrowser.Models"
        Title="FingerprintBrowser - 指纹浏览器" 
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#f5f6fa">

    <Window.Resources>
        <local:BrowserStatusToBrushConverter x:Key="StatusToBrush"/>
        <local:BrowserStatusToTextConverter x:Key="StatusToText"/>
        <local:ProxyStatusToBrushConverter x:Key="ProxyStatusToBrush"/>
        <local:ProxyStatusToTextConverter x:Key="ProxyStatusToText"/>
        <local:StringToColorConverter x:Key="StringToColor"/>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderBrush" Value="{x:Null}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#e8f0fe"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{x:Null}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#e8f0fe"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== LEFT SIDEBAR ========== -->
        <Border Grid.Column="0" Background="White" BorderBrush="#e8e8e8" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- New Environment Button -->
                <Button DockPanel.Dock="Top" Margin="16,16,16,8"
                        Command="{Binding NewEnvironmentCommand}"
                        Height="40" Background="#1677ff" Foreground="White"
                        FontWeight="Medium" FontSize="14"
                        BorderBrush="{x:Null}" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="新建环境" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Start All / Stop All -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,0,16,12">
                    <Button Width="90" Height="32" Margin="0,0,8,0"
                            Command="{Binding StartAllCommand}"
                            Background="White" BorderBrush="#1677ff" Foreground="#1677ff"
                            FontSize="12" Cursor="Hand">
                        启动全部
                    </Button>
                    <Button Width="90" Height="32"
                            Command="{Binding StopAllCommand}"
                            Background="White" BorderBrush="#999" Foreground="#666"
                            FontSize="12" Cursor="Hand">
                        停止全部
                    </Button>
                </StackPanel>

                <!-- Separator -->
                <Separator DockPanel.Dock="Top" Margin="16,0"/>

                <!-- Group Header -->
                <Grid DockPanel.Dock="Top" Margin="16,12,16,4">
                    <TextBlock Text="分组" FontWeight="SemiBold" FontSize="13" Foreground="#333" 
                               VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Width="24" Height="24"
                            Command="{Binding NewGroupCommand}"
                            Style="{StaticResource ActionIconButton}" FontSize="16" Foreground="#1677ff">
                        +
                    </Button>
                </Grid>

                <!-- Group List -->
                <ListBox DockPanel.Dock="Top" Margin="8,0"
                         ItemsSource="{Binding Groups}"
                         SelectedItem="{Binding SelectedGroup}"
                         BorderBrush="{x:Null}" Background="Transparent"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:EnvironmentGroup}">
                            <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="10" Height="10" 
                                         Fill="{Binding Color, Converter={StaticResource StringToColor}}"
                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" 
                                           Foreground="#333" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <Border Grid.Column="2" Background="#f0f0f0" CornerRadius="8" 
                                        Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EnvironmentCount}" FontSize="11" Foreground="#999"/>
                                </Border>

                                <Button Grid.Column="3" Width="20" Height="20" Margin="4,0,0,0"
                                        Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ActionIconButton}"
                                        FontSize="10" Foreground="#999" ToolTip="删除分组">
                                    x
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#e8f0fe"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#f5f6fa"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ========== MAIN CONTENT ========== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" Margin="0" 
                        SelectedIndex="{Binding SelectedTabIndex}"
                        BorderBrush="{x:Null}" Background="Transparent">

                <!-- ===== TAB 1: 环境管理 ===== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="环境管理" FontSize="14" Margin="8,0"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Button Width="72" Height="32" Margin="0,0,8,0"
                                        Command="{Binding StartAllCommand}"
                                        Background="#1677ff" Foreground="White"
                                        BorderBrush="{x:Null}" FontSize="12" Cursor="Hand">
                                    启动
                                </Button>
                                <Button Width="72" Height="32" Margin="0,0,8,0"
                                        Command="{Binding StopAllCommand}"
                                        Background="White" Foreground="#666"
                                        BorderBrush="#d9d9d9" FontSize="12" Cursor="Hand">
                                    停止
                                </Button>
                                <Button Width="72" Height="32" Margin="0,0,8,0"
                                        Command="{Binding BatchDeleteCommand}"
                                        Background="White" Foreground="#ff4d4f"
                                        BorderBrush="#ffccc7" FontSize="12" Cursor="Hand">
                                    删除
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <hc:SearchBar Width="240" Height="32"
                                              Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                              hc:InfoElement.PlaceholderText="搜索环境..."
                                              SearchStarted="SearchBar_SearchStarted"/>
                            </StackPanel>
                        </Grid>

                        <!-- Data Table -->
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding FilteredEnvironments}"
                                  SelectedItem="{Binding SelectedEnvironment}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" SelectionMode="Single"
                                  BorderBrush="#e8e8e8" BorderThickness="1"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#f0f0f0"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#fafafa"
                                  FontSize="13" RowHeight="48">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="#" Width="40" Binding="{Binding Id}"/>

                                <DataGridTemplateColumn Header="名称" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="28" Height="28" CornerRadius="14" 
                                                        Background="#1677ff" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding AvatarLetter}" 
                                                               Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="状态" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Status, Converter={StaticResource StatusToBrush}}" 
                                                    CornerRadius="10" Padding="10,3" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}" 
                                                           Foreground="White" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="系统" Width="70" Binding="{Binding OS}"/>

                                <DataGridTextColumn Header="代理" Width="200" Binding="{Binding ProxyDisplay}"/>

                                <DataGridTextColumn Header="最后打开" Width="150" Binding="{Binding LastOpenedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>

                                <DataGridTemplateColumn Header="操作" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource ActionIconButton}"
                                                        Command="{Binding DataContext.StartBrowserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="启动" Foreground="#52c41a">
                                                    &#9654;
                                                </Button>
                                                <Button Style="{StaticResource ActionIconButton}"
                                                        Command="{Binding DataContext.StopBrowserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="停止" Foreground="#ff4d4f">
                                                    &#9632;
                                                </Button>
                                                <Button Style="{StaticResource ActionIconButton}"
                                                        Command="{Binding DataContext.EditFingerprintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="指纹" Foreground="#722ed1">
                                                    &#9758;
                                                </Button>
                                                <Button Style="{StaticResource ActionIconButton}"
                                                        Command="{Binding DataContext.EditEnvironmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="编辑" Foreground="#1677ff">
                                                    &#9998;
                                                </Button>
                                                <Button Style="{StaticResource ActionIconButton}"
                                                        Command="{Binding DataContext.DeleteEnvironmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="删除" Foreground="#ff4d4f">
                                                    &#10005;
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ===== TAB 2: 代理管理 ===== -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="代理管理" FontSize="14" Margin="8,0"/>
                    </TabItem.Header>

                    <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Stats Cards -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="正常" FontSize="13" Foreground="#999"/>
                                        <TextBlock Text="{Binding ProxyNormalCount}" FontSize="28" FontWeight="Bold" 
                                                   Foreground="#52c41a" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="8,0">
                                    <StackPanel>
                                        <TextBlock Text="失败" FontSize="13" Foreground="#999"/>
                                        <TextBlock Text="{Binding ProxyFailedCount}" FontSize="28" FontWeight="Bold" 
                                                   Foreground="#ff4d4f" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="未测试" FontSize="13" Foreground="#999"/>
                                        <TextBlock Text="{Binding ProxyUntestedCount}" FontSize="28" FontWeight="Bold" 
                                                   Foreground="#999" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Add Proxy Button -->
                            <Button HorizontalAlignment="Left" Margin="0,0,0,12"
                                    Command="{Binding NewProxyCommand}"
                                    Height="36" Padding="16,0"
                                    Background="#1677ff" Foreground="White"
                                    BorderBrush="{x:Null}" FontSize="13" Cursor="Hand">
                                + 添加代理
                            </Button>

                            <!-- Proxy List -->
                            <DataGrid ItemsSource="{Binding ProxyConfigs}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      BorderBrush="#e8e8e8" BorderThickness="1"
                                      Background="White" RowBackground="White"
                                      AlternatingRowBackground="#fafafa"
                                      FontSize="13" RowHeight="44">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Width="50" Binding="{Binding Id}"/>
                                    <DataGridTextColumn Header="名称" Width="150" Binding="{Binding Name}"/>
                                    <DataGridTextColumn Header="类型" Width="80" Binding="{Binding TypeDisplay}"/>
                                    <DataGridTextColumn Header="服务器" Width="200" Binding="{Binding Host}"/>
                                    <DataGridTextColumn Header="端口" Width="80" Binding="{Binding Port}"/>

                                    <DataGridTemplateColumn Header="状态" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Status, Converter={StaticResource ProxyStatusToBrush}}" 
                                                        CornerRadius="10" Padding="10,3" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource ProxyStatusToText}}" 
                                                               Foreground="White" FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="最后测试" Width="150" Binding="{Binding LastTestedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>

                                    <DataGridTemplateColumn Header="操作" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ActionIconButton}"
                                                            Command="{Binding DataContext.TestProxyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="测试" Foreground="#1677ff">
                                                        &#9889;
                                                    </Button>
                                                    <Button Style="{StaticResource ActionIconButton}"
                                                            Command="{Binding DataContext.DeleteProxyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="删除" Foreground="#ff4d4f">
                                                        &#10005;
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== TAB 3: 系统设置 ===== -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="系统设置" FontSize="14" Margin="8,0"/>
                    </TabItem.Header>

                    <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 通用设置 -->
                            <Border Style="{StaticResource StatCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="通用设置" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="最大并发数" FontSize="13" Foreground="#666" VerticalAlignment="Center"/>
                                        <hc:NumericUpDown Grid.Column="1" Value="{Binding MaxConcurrency}" 
                                                          Minimum="1" Maximum="20" Width="120" 
                                                          HorizontalAlignment="Left"/>
                                    </Grid>

                                    <CheckBox Content="启动时自动打开浏览器" IsChecked="{Binding AutoStartBrowser}" 
                                              Margin="0,0,0,8" FontSize="13"/>
                                    <CheckBox Content="关闭时最小化到托盘" IsChecked="{Binding MinimizeToTray}" 
                                              Margin="0,0,0,8" FontSize="13"/>
                                    <CheckBox Content="启用自动更新" IsChecked="{Binding EnableAutoUpdate}" 
                                              FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <!-- 指纹设置 -->
                            <Border Style="{StaticResource StatCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="指纹设置" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="默认 UserAgent" FontSize="13" Foreground="#666" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" SelectedItem="{Binding DefaultUserAgent}" Width="300" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Chrome 120 / Win10" IsSelected="True"/>
                                            <ComboBoxItem Content="Chrome 119 / Win11"/>
                                            <ComboBoxItem Content="Chrome 120 / macOS"/>
                                            <ComboBoxItem Content="Firefox 121 / Win10"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="默认分辨率" FontSize="13" Foreground="#666" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" SelectedItem="{Binding DefaultResolution}" Width="200" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="1920x1080" IsSelected="True"/>
                                            <ComboBoxItem Content="1366x768"/>
                                            <ComboBoxItem Content="1536x864"/>
                                            <ComboBoxItem Content="2560x1440"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="默认语言" FontSize="13" Foreground="#666" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" SelectedItem="{Binding DefaultLanguage}" Width="200" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="en-US" IsSelected="True"/>
                                            <ComboBoxItem Content="zh-CN"/>
                                            <ComboBoxItem Content="ja-JP"/>
                                            <ComboBoxItem Content="ko-KR"/>
                                        </ComboBox>
                                    </Grid>

                                    <CheckBox Content="启用 Canvas 噪声" IsChecked="{Binding EnableCanvasNoise}" 
                                              Margin="0,0,0,8" FontSize="13"/>
                                    <CheckBox Content="启用 Audio 噪声" IsChecked="{Binding EnableAudioNoise}" 
                                              Margin="0,0,0,8" FontSize="13"/>
                                    <CheckBox Content="启用 WebGL 噪声" IsChecked="{Binding EnableWebGLNoise}" 
                                              Margin="0,0,0,8" FontSize="13"/>
                                    <CheckBox Content="启用字体噪声" IsChecked="{Binding EnableFontNoise}" 
                                              Margin="0,0,0,8" FontSize="13"/>
                                    <CheckBox Content="阻止 WebRTC" IsChecked="{Binding BlockWebRTC}" 
                                              FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <!-- 浏览器设置 -->
                            <Border Style="{StaticResource StatCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="浏览器设置" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="启动延迟(秒)" FontSize="13" Foreground="#666" VerticalAlignment="Center"/>
                                        <hc:NumericUpDown Grid.Column="1" Value="{Binding StartupDelay}" 
                                                          Minimum="0" Maximum="30" Width="120" 
                                                          HorizontalAlignment="Left"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="浏览器路径" FontSize="13" Foreground="#666" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding BrowserPath}" Width="400" 
                                                 HorizontalAlignment="Left" hc:InfoElement.PlaceholderText="留空使用默认 Chromium"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- ========== STATUS BAR ========== -->
            <Border Grid.Row="1" Background="White" BorderBrush="#e8e8e8" BorderThickness="0,1,0,0"
                    Padding="16,8">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="总计: " FontSize="12" Foreground="#999" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="12" Foreground="#333" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text=" | 运行: " FontSize="12" Foreground="#999" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RunningCount}" FontSize="12" Foreground="#52c41a" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text=" | 停止: " FontSize="12" Foreground="#999" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StoppedCount}" FontSize="12" Foreground="#999" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text=" | 并发上限: " FontSize="12" Foreground="#999" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MaxConcurrency}" FontSize="12" Foreground="#1677ff" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" Text="{Binding StatusMessage}" 
                               FontSize="12" Foreground="#999" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
