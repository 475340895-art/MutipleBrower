<hc:Window x:Class="FingerprintBrowser.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="指纹浏览器" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RegionBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1a1a2e" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#667eea" VerticalAlignment="Center"/>
                    <TextBlock Text="指纹浏览器" FontSize="18" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="批量启动" Style="{StaticResource ButtonPrimary}" Margin="0,0,10,0" Click="BatchStart_Click"/>
                    <Button Content="批量停止" Margin="0,0,10,0" Click="BatchStop_Click"/>
                    <Button Content="新建环境" Style="{StaticResource ButtonSuccess}" Margin="0,0,10,0" Click="NewEnvironment_Click"/>
                    
                    <hc:DropDownButton Content="主题" Margin="0,0,10,0">
                        <hc:DropDownButton.DropDownContent>
                            <StackPanel>
                                <MenuItem Header="深色" Click="ThemeDark_Click"/>
                                <MenuItem Header="浅色" Click="ThemeLight_Click"/>
                                <MenuItem Header="深蓝" Click="ThemeBlue_Click"/>
                            </StackPanel>
                        </hc:DropDownButton.DropDownContent>
                    </hc:DropDownButton>

                    <Button Content="代理" Margin="0,0,10,0" Click="OpenProxyWindow_Click"/>
                    <Button Content="设置" Click="OpenSettingsWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Groups -->
            <Border Background="#16213e" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="10">
                        <TextBlock Text="分组" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="+" Width="28" Height="28" Margin="10,0,0,0" Click="AddGroup_Click"/>
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="GroupList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="GroupList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <Ellipse Width="12" Height="12" Margin="0,0,8,0">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding Color}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Name}" Foreground="White"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Center Panel - Environment List -->
            <Border Grid.Column="1" Background="#16213e" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <hc:SearchBar x:Name="SearchBox" hc:InfoElement.Placeholder="搜索环境..." 
                                      Style="{StaticResource SearchBarExtend}"
                                      TextChanged="SearchBox_TextChanged"/>
                        
                        <Button Grid.Column="1" Content="导入" Margin="10,0,0,0" Click="Import_Click"/>
                        <Button Grid.Column="2" Content="导出" Margin="10,0,0,0" Click="Export_Click"/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="EnvironmentGrid" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                              Background="Transparent" BorderThickness="0" Margin="5"
                              ItemsSource="{Binding FilteredEnvironments}"
                              SelectedItem="{Binding SelectedEnvironment}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="状态" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding StatusColor}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="分组" Binding="{Binding GroupName}" Width="100"/>
                            <DataGridTextColumn Header="代理" Binding="{Binding ProxyInfo}" Width="150"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                            <DataGridTemplateColumn Header="操作" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="启动" Click="StartBrowser_Click" Margin="2"/>
                                            <Button Content="停止" Click="StopBrowser_Click" Margin="2"/>
                                            <Button Content="编辑" Click="EditEnvironment_Click" Margin="2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right Panel - Details -->
            <Border Grid.Column="2" Background="#16213e" Margin="5" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedEnvironment}">
                        <TextBlock Text="环境详情" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                        <TextBlock Text="名称" Foreground="#a0a0a0"/>
                        <TextBlock Text="{Binding Name}" Foreground="White" Margin="0,0,0,10"/>

                        <TextBlock Text="分组" Foreground="#a0a0a0"/>
                        <TextBlock Text="{Binding GroupName}" Foreground="White" Margin="0,0,0,10"/>

                        <TextBlock Text="分辨率" Foreground="#a0a0a0"/>
                        <TextBlock Text="{Binding Resolution}" Foreground="White" Margin="0,0,0,10"/>

                        <TextBlock Text="时区" Foreground="#a0a0a0"/>
                        <TextBlock Text="{Binding Timezone}" Foreground="White" Margin="0,0,0,10"/>

                        <TextBlock Text="语言" Foreground="#a0a0a0"/>
                        <TextBlock Text="{Binding Languages}" Foreground="White" Margin="0,0,0,10"/>

                        <TextBlock Text="UserAgent" Foreground="#a0a0a0"/>
                        <TextBlock Text="{Binding UserAgent}" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="代理" Foreground="#a0a0a0"/>
                        <TextBlock Text="{Binding ProxyInfo}" Foreground="White" Margin="0,0,0,10"/>

                        <TextBlock Text="备注" Foreground="#a0a0a0"/>
                        <TextBlock Text="{Binding Remark}" Foreground="White" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#1a1a2e" Padding="15,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#a0a0a0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="总计:" Foreground="#a0a0a0" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TotalCount}" Foreground="White" Margin="0,0,15,0"/>
                    <TextBlock Text="运行中:" Foreground="#a0a0a0" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding RunningCount}" Foreground="#34d399"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</hc:Window>
