<hc:Window x:Class="FingerprintBrowser.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="指纹浏览器 - Fingerprint Browser"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RegionBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#1a1a2e" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="指纹浏览器" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="StatsText" Text=" | 0 运行中 / 0 总数" FontSize="14" 
                               Foreground="#888" VerticalAlignment="Bottom" Margin="20,0,0,4"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSettings" Content="设置" Width="80" Height="36" 
                            Style="{StaticResource ButtonDefault}" Margin="5,0"/>
                    <ComboBox x:Name="ThemeCombo" Width="100" Height="36" Margin="5,0"
                              SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="深色" IsSelected="True"/>
                        <ComboBoxItem Content="浅色"/>
                        <ComboBoxItem Content="深蓝"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Panel - Groups -->
            <Border Background="#16213e" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="分组" FontSize="16" FontWeight="Bold" Foreground="White" Margin="5,10,5,5"/>
                    
                    <Button x:Name="BtnAddGroup" Grid.Row="1" Content="+ 新建分组" 
                            HorizontalAlignment="Stretch" Height="36" Margin="5" 
                            Style="{StaticResource ButtonPrimary}" Click="BtnAddGroup_Click"/>
                    
                    <ListBox x:Name="GroupsList" Grid.Row="2" Background="Transparent" 
                             BorderThickness="0" Margin="0,10,0,0" SelectionChanged="GroupsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <Ellipse Width="12" Height="12" Fill="{Binding Color}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            
            <!-- Right Panel - Environments -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Toolbar -->
                <Border Background="#1e1e2e" Padding="15,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="SearchBox" Width="200" Height="36" 
                                     hc:InfoElement.Placeholder="搜索环境..."
                                     TextChanged="SearchBox_TextChanged"/>
                            <Button x:Name="BtnBatchStart" Content="批量启动" Width="100" Height="36" 
                                    Margin="10,0,5" Style="{StaticResource ButtonSuccess}" Click="BtnBatchStart_Click"/>
                            <Button x:Name="BtnBatchStop" Content="批量停止" Width="100" Height="36" 
                                    Margin="5,0" Style="{StaticResource ButtonDanger}" Click="BtnBatchStop_Click"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnAddEnv" Content="+ 新建环境" Width="120" Height="36" 
                                    Style="{StaticResource ButtonPrimary}" Click="BtnAddEnv_Click"/>
                            <Button x:Name="BtnImport" Content="导入" Width="80" Height="36" 
                                    Margin="10,0,5" Click="BtnImport_Click"/>
                            <Button x:Name="BtnExport" Content="导出" Width="80" Height="36" 
                                    Margin="5,0" Click="BtnExport_Click"/>
                            <Button x:Name="BtnProxy" Content="代理管理" Width="100" Height="36" 
                                    Margin="5,0" Click="BtnProxy_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Environment List -->
                <DataGrid x:Name="EnvGrid" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single"
                          Background="Transparent" BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="状态" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="分组" Binding="{Binding GroupName}" Width="100"/>
                        <DataGridTextColumn Header="启动网址" Binding="{Binding StartupUrl}" Width="*"/>
                        <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="150"/>
                        <DataGridTemplateColumn Header="操作" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="启动" Click="StartEnv_Click" Tag="{Binding Id}" 
                                                Width="60" Height="28" Style="{StaticResource ButtonSuccess}"/>
                                        <Button Content="停止" Click="StopEnv_Click" Tag="{Binding Id}" 
                                                Width="60" Height="28" Margin="5,0" Style="{StaticResource ButtonDanger}"/>
                                        <Button Content="编辑" Click="EditEnv_Click" Tag="{Binding Id}" 
                                                Width="60" Height="28"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</hc:Window>
