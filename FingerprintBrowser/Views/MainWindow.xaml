<hc:Window x:Class="FingerprintBrowser.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:vm="clr-namespace:FingerprintBrowser.ViewModels"
        mc:Ignorable="d"
        Title="指纹浏览器 - Fingerprint Browser"
        Height="750" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        NonClientAreaBackground="#1a1a2e"
        NonClientAreaForeground="White"
        Background="#0f0f1a"
        Loaded="Window_Loaded">
    
    <Window.Resources>
        <!-- 渐变背景 -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00d4ff" Offset="0"/>
            <GradientStop Color="#7c3aed" Offset="1"/>
        </LinearGradientBrush>
        
        <!-- 科技感按钮样式 -->
        <Style x:Key="TechButton" TargetType="Button">
            <Setter Property="Background" Value="#2d2d44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3d3d5c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4d4d6c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource TechButton}">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8888aa"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2d2d44"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 列表项样式 -->
        <Style x:Key="EnvListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1e1e32"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2a2a4a"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#667eea"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 输入框样式 -->
        <Style x:Key="TechTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1a1a2e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3d3d5c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#667eea"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 状态指示器 -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        
        <!-- 卡片样式 -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1a1a2e"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        
        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#12121f">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Logo和标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentGradient}" Margin="0,0,12,0">
                        <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z"
                              Fill="White" Width="20" Height="20" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="指纹浏览器" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Fingerprint Browser" FontSize="10" Foreground="#666688"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- 工具按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource TechButton}" Content="新建环境" Click="NewEnvironment_Click" Margin="4,0"/>
                    <Button Style="{StaticResource TechButton}" Content="批量启动" Click="BatchStart_Click" Margin="4,0"/>
                    <Button Style="{StaticResource TechButton}" Content="批量停止" Click="BatchStop_Click" Margin="4,0"/>
                    <Separator Style="{StaticResource VerticalSeparatorStyle}" Margin="8,8"/>
                    <Button Style="{StaticResource TechButton}" Content="代理管理" Click="ProxyManage_Click" Margin="4,0"/>
                    <Button Style="{StaticResource TechButton}" Content="导入/导出" Click="ImportExport_Click" Margin="4,0"/>
                </StackPanel>
                
                <!-- 右侧设置 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0">
                    <ComboBox x:Name="ThemeCombo" Width="100" Margin="0,0,12,0"
                              SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="深色主题" Tag="Dark" IsSelected="True"/>
                        <ComboBoxItem Content="浅色主题" Tag="Light"/>
                        <ComboBoxItem Content="深蓝主题" Tag="DeepBlue"/>
                    </ComboBox>
                    <Button Style="{StaticResource IconButton}" Content="⚙" FontSize="16" Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧分组列表 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="分组管理" FontSize="14" FontWeight="SemiBold" 
                               Foreground="White" Margin="0,0,0,12"/>
                    
                    <!-- 搜索框 -->
                    <TextBox Grid.Row="1" x:Name="GroupSearchBox" Style="{StaticResource TechTextBox}"
                             hc:InfoElement.Placeholder="搜索分组..." Margin="0,0,0,12"
                             TextChanged="GroupSearchBox_TextChanged"/>
                    
                    <!-- 分组列表 -->
                    <ListBox Grid.Row="2" x:Name="GroupListBox" Background="Transparent" 
                             BorderThickness="0" ItemContainerStyle="{StaticResource EnvListItem}"
                             SelectionChanged="GroupListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Margin="0,0,10,0">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding Color}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding EnvironmentCount, StringFormat=' ({0})'}" 
                                               Foreground="#666688" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            
            <!-- 中间环境列表 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 标题栏 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="环境列表" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock x:Name="EnvCountText" Text=" (0)" Foreground="#666688" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" x:Name="EnvSearchBox" Width="200" Style="{StaticResource TechTextBox}"
                                 hc:InfoElement.Placeholder="搜索环境..." TextChanged="EnvSearchBox_TextChanged"/>
                    </Grid>
                    
                    <!-- 操作按钮 -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                        <Button Style="{StaticResource AccentButton}" Content="+ 新建" Click="NewEnvironment_Click" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource TechButton}" Content="▶ 启动" Click="StartEnvironment_Click" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource TechButton}" Content="⏹ 停止" Click="StopEnvironment_Click" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource TechButton}" Content="✎ 编辑" Click="EditEnvironment_Click" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource TechButton}" Content="⧉ 复制" Click="CopyEnvironment_Click" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource TechButton}" Content="🗑 删除" Click="DeleteEnvironment_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    
                    <!-- 环境列表 -->
                    <DataGrid Grid.Row="2" x:Name="EnvironmentGrid" AutoGenerateColumns="False"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                              HeadersVisibility="Column" RowBackground="Transparent"
                              AlternatingRowBackground="#151525" CanUserAddRows="False"
                              SelectionMode="Single" IsReadOnly="True"
                              MouseDoubleClick="EnvironmentGrid_MouseDoubleClick">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0f0f1a"/>
                                <Setter Property="Foreground" Value="#8888aa"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#e0e0e0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2a2a4a"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1e1e32"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2a2a4a"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="状态" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Running">
                                                            <Setter Property="Fill" Value="#00ff88"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                            <Setter Property="Fill" Value="#ffaa00"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                            <Setter Property="Fill" Value="#ff4466"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Stopping">
                                                            <Setter Property="Fill" Value="#ffaa00"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Idle">
                                                            <Setter Property="Fill" Value="#666688"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="分组" Binding="{Binding GroupName}" Width="80"/>
                            <DataGridTextColumn Header="代理" Binding="{Binding ProxyInfo}" Width="*"/>
                            <DataGridTextColumn Header="启动页" Binding="{Binding StartupUrl}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            
            <!-- 右侧详情 -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="环境详情" FontSize="14" FontWeight="SemiBold" 
                               Foreground="White" Margin="0,0,0,16"/>
                    
                    <!-- 详情内容 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                            <!-- 名称 -->
                            <TextBlock Text="名称" Foreground="#666688" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DetailName" Text="" Foreground="White" FontSize="14" Margin="0,0,0,16"/>
                            
                            <!-- 分组 -->
                            <TextBlock Text="分组" Foreground="#666688" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DetailGroup" Text="" Foreground="White" FontSize="14" Margin="0,0,0,16"/>
                            
                            <!-- 状态 -->
                            <TextBlock Text="状态" Foreground="#666688" FontSize="11" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Ellipse x:Name="DetailStatusDot" Width="8" Height="8" Margin="0,0,8,0"/>
                                <TextBlock x:Name="DetailStatus" Text="" Foreground="White" FontSize="14"/>
                            </StackPanel>
                            
                            <!-- 代理 -->
                            <TextBlock Text="代理配置" Foreground="#666688" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DetailProxy" Text="" Foreground="#00d4ff" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            
                            <!-- 指纹信息 -->
                            <TextBlock Text="指纹信息" Foreground="#666688" FontSize="11" Margin="0,0,0,8"/>
                            <Border Background="#0f0f1a" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="User Agent" Foreground="#666688" FontSize="11"/>
                                        <TextBlock x:Name="DetailUA" Grid.Column="1" Text="" Foreground="#aaaacc" FontSize="11" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="分辨率" Foreground="#666688" FontSize="11"/>
                                        <TextBlock x:Name="DetailResolution" Grid.Column="1" Text="" Foreground="#aaaacc" FontSize="11"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="时区" Foreground="#666688" FontSize="11"/>
                                        <TextBlock x:Name="DetailTimezone" Grid.Column="1" Text="" Foreground="#aaaacc" FontSize="11"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="语言" Foreground="#666688" FontSize="11"/>
                                        <TextBlock x:Name="DetailLanguage" Grid.Column="1" Text="" Foreground="#aaaacc" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- 启动页 -->
                            <TextBlock Text="启动页面" Foreground="#666688" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DetailUrl" Text="" Foreground="#aaaacc" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            
                            <!-- 创建时间 -->
                            <TextBlock Text="创建时间" Foreground="#666688" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DetailCreated" Text="" Foreground="#aaaacc" FontSize="12" Margin="0,0,0,16"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- 空状态 -->
                    <StackPanel x:Name="EmptyDetailPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="选择环境查看详情" Foreground="#444466" FontSize="13" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- 操作按钮 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="▶ 启动" Click="StartEnvironment_Click" Margin="0,0,8,0" Padding="20,10"/>
                        <Button Style="{StaticResource TechButton}" Content="✎ 编辑" Click="EditEnvironment_Click" Margin="0,0,8,0" Padding="20,10"/>
                        <Button Style="{StaticResource TechButton}" Content="⧉ 复制" Click="CopyEnvironment_Click" Padding="20,10"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#0a0a14" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="就绪" Foreground="#666688" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0">
                    <Ellipse Width="6" Height="6" Fill="#00ff88" Margin="0,0,6,0"/>
                    <TextBlock x:Name="RunningCountText" Text="运行中: 0" Foreground="#666688" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0">
                    <Ellipse Width="6" Height="6" Fill="#666688" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TotalCountText" Text="总计: 0" Foreground="#666688" VerticalAlignment="Center"/>
                </StackPanel>
                
                <TextBlock Grid.Column="3" Text="v1.0.0" Foreground="#444466" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        
        <!-- 加载遮罩 -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#cc000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <hc:LoadingCircle/>
                <TextBlock x:Name="LoadingText" Text="加载中..." Foreground="White" Margin="0,16,0,0" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</hc:Window>
