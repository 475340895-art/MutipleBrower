<Application x:Class="FingerprintBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:converters="clr-namespace:FingerprintBrowser.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- HandyControl 主题 -->
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                
                <!-- 自定义资源 -->
                <ResourceDictionary Source="/Resources/CustomStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- 全局转换器 -->
            <converters:BoolToVisConverter x:Key="BoolToVisConverter"/>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <converters:StatusColorConverter x:Key="StatusColorConverter"/>
            <converters:StatusTextConverter x:Key="StatusTextConverter"/>
            <converters:ProxyStatusColorConverter x:Key="ProxyStatusColorConverter"/>
            <converters:ProxyStatusTextConverter x:Key="ProxyStatusTextConverter"/>
            <converters:DateTimeConverter x:Key="DateTimeConverter"/>
            <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
