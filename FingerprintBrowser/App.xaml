<Application x:Class="FingerprintBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:FingerprintBrowser.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <hc:ResourceDictionary/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BrowserStatusToBrushConverter x:Key="StatusToBrushConverter"/>
            <conv:BrowserStatusToTextConverter x:Key="StatusToTextConverter"/>
            <conv:ProxyStatusToBrushConverter x:Key="ProxyStatusToBrushConverter"/>
            <conv:ProxyStatusToTextConverter x:Key="ProxyStatusToTextConverter"/>
            <conv:StringToColorConverter x:Key="StringToColorConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
