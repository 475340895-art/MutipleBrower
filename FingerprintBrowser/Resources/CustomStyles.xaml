<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol">

    <!-- 垂直分隔线样式 -->
    <Style x:Key="VerticalSeparatorStyle" TargetType="Separator">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="#3d3d5c"/>
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" 
                            Width="{TemplateBinding Width}" 
                            Height="{TemplateBinding Height}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 按钮图标样式 -->
    <Style x:Key="ButtonIcon" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <!-- 搜索框扩展样式 -->
    <Style x:Key="SearchBarExtend" TargetType="TextBox" BasedOn="{StaticResource TextBoxExtend}">
        <Setter Property="Background" Value="#1a1a2e"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#3d3d5c"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <!-- 卡片样式 -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="#1a1a2e"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- 数据表格样式 -->
    <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="#151525"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
    </Style>

    <!-- 数据表格列头样式 -->
    <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#0f0f1a"/>
        <Setter Property="Foreground" Value="#8888aa"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 数据表格单元格样式 -->
    <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#e0e0e0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#2a2a4a"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 状态指示器颜色 -->
    <SolidColorBrush x:Key="StatusRunningBrush" Color="#00ff88"/>
    <SolidColorBrush x:Key="StatusStartingBrush" Color="#ffaa00"/>
    <SolidColorBrush x:Key="StatusStoppingBrush" Color="#ffaa00"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#ff4466"/>
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#666688"/>

    <!-- 主题颜色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#667eea"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#764ba2"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#00d4ff"/>

    <!-- 背景颜色 -->
    <SolidColorBrush x:Key="DarkBackgroundBrush" Color="#0f0f1a"/>
    <SolidColorBrush x:Key="DarkCardBrush" Color="#1a1a2e"/>
    <SolidColorBrush x:Key="DarkHoverBrush" Color="#2d2d44"/>
    <SolidColorBrush x:Key="DarkBorderBrush" Color="#3d3d5c"/>

    <!-- 文本颜色 -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8888aa"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#666688"/>

    <!-- 列表项样式 -->
    <Style x:Key="ListItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#e0e0e0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1e1e32"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#2a2a4a"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滚动条样式 -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
    </Style>

</ResourceDictionary>
